<?xml version="1.0" encoding="utf-8"?>
<!--
  #102: scan, NFC tag write / inspect, and the navigation shell — English source. Comments carry the ratification
  ids and what each string is for. The tag-flow sheets follow G1 §1.4 / D12 §11: an eyebrow (drawn in capitals),
  one sentence, a mono identifier, then the actions. "ServiceTag", "NoteTag" and "NFC" / "NDEF" are never translated.
-->
<resources>

    <!-- ===================================================================== navigation shell -->

    <!-- Bottom bar, first destination (RATIFIED). -->
    <string name="nav_dashboard">Dashboard</string>
    <!-- Bottom bar, second destination (RATIFIED); also the share picker's first list. -->
    <string name="nav_assets">Assets</string>
    <!-- Bottom bar, third destination (RATIFIED, spec §9.1 verbatim, D-24). -->
    <string name="nav_maintenance">Maintenance</string>
    <!-- Snackbar: a servicetag:// link this app answers but that names nothing it can open (a malformed id, or a tag link in a newer format). -->
    <string name="nav_link_points_nowhere">That link doesn\'t point at anything here.</string>

    <!-- ===================================================================== Read / inspect tag screen -->

    <!-- The inspect screen's title; Settings' row of the same name opens it. -->
    <string name="scan_title">Read / inspect tag</string>
    <!-- Accessibility: the inspect screen's back arrow. -->
    <string name="scan_back">Back</string>
    <!-- The scan card's status line while waiting for a tag (written in capitals). -->
    <string name="scan_ready">READY TO SCAN</string>
    <!-- The scan card's status line while a tag that was just felt is being read (written in capitals). -->
    <string name="scan_reading">READING TAG</string>
    <!-- The scan card's one sentence. -->
    <string name="scan_hold_hint">Hold the top of your phone near the equipment tag.</string>
    <!-- Quiet line: the inspect screen is shown without an activity that can own reader mode. -->
    <string name="scan_needs_window">Scanning needs the app\'s own window.</string>
    <!-- Quiet line under the scan card: reading the tag threw (E2). The details go to the log, not here. -->
    <string name="scan_read_failed">Couldn\'t read that tag. Hold it still and try again.</string>
    <!--
      Why a tag is not ours, shown as the quiet line of the "Not a ServiceTag tag" sheet after "unreadable ServiceTag
      record:" (tag_reason_unreadable): the tag cannot hold NDEF at all.
    -->
    <string name="scan_reason_no_ndef">this tag does not support NDEF</string>

    <!-- ===================================================================== NFC availability and dispatch -->

    <!-- Quiet line on the inspect and write screens: the phone has no NFC radio. -->
    <string name="nfc_no_hardware">This phone has no NFC hardware.</string>
    <!-- Quiet line on the inspect and write screens: NFC is switched off in the system settings. -->
    <string name="nfc_turned_off">NFC is turned off. Enable it in system settings, then come back.</string>
    <!-- Toast: a background tag dispatch or tag link carried nothing this app can resolve. -->
    <string name="nfc_nothing_to_resolve">Nothing to resolve.</string>
    <!--
      Quiet line of the "Not a ServiceTag tag" sheet when the background lookup failed.
      %1$s: the failure's technical type name (e.g. IOException), shown as is.
    -->
    <string name="nfc_could_not_resolve">could not resolve this tag: %1$s</string>

    <!-- ===================================================================== tag result sheet (D12 §11, G1 §1.4) -->

    <!-- Eyebrow while the scanned tag is looked up. -->
    <string name="tag_eyebrow_reading">Reading tag</string>
    <!-- Sentence while the scanned tag is looked up. -->
    <string name="tag_looking_up">Looking this tag up…</string>
    <!-- Eyebrow of a deliberate inspect of a tag bound to an asset (#41); the sentence is the asset's name. -->
    <string name="tag_eyebrow_servicetag">ServiceTag tag</string>
    <!-- Button: open the asset the inspected tag is bound to. -->
    <string name="tag_open_asset">Open asset</string>
    <!-- Button: close the tag sheet without doing anything. -->
    <string name="tag_cancel">Cancel</string>
    <!-- Eyebrow of a background scan of a tag this phone knows (bound asset, or a pre-split note link). -->
    <string name="tag_eyebrow_detected">Tag detected</string>
    <!-- Quiet line while a background scan opens the tag's asset by itself. -->
    <string name="tag_opening_asset">Opening asset…</string>
    <!-- P70-5, also the inspect sheet's sentence for a tag bound to a note link from before the ServiceTag / NoteTag split (owner ruling 2026-09-18). -->
    <string name="tag_pre_split_link">This tag points at a note link from before the product split. ServiceTag no longer opens links; NoteTag does.</string>
    <!-- Eyebrow of a ServiceTag tag that is not bound to anything, or not in this phone's records. -->
    <string name="tag_eyebrow_unregistered">Unregistered tag</string>
    <!-- Sentence of a known tag that is bound to nothing. -->
    <string name="tag_not_assigned">This tag is not assigned to anything yet.</string>
    <!-- Button: choose the asset this tag should identify. -->
    <string name="tag_bind_to_asset">Bind to asset</string>
    <!-- Eyebrow of a tag that was marked lost. -->
    <string name="tag_eyebrow_marked_lost">Tag marked lost</string>
    <!-- Eyebrow of a tag that was retired. -->
    <string name="tag_eyebrow_retired">Tag retired</string>
    <!-- Sentence of a lost or retired tag. -->
    <string name="tag_revoked_sentence">This tag was taken out of service. Binding it again puts it back to work.</string>
    <!-- P70-4: a valid ServiceTag tag this phone has no record of — the inspect sheet's sentence, and the overwrite sheet's line for the same state. -->
    <string name="tag_not_in_records">This ServiceTag tag is not in this phone\'s records.</string>
    <!-- Button: go to the write screen to write a fresh identity over this tag. -->
    <string name="tag_write_over_it">Write a new tag over it</string>
    <!-- Eyebrow of a tag that holds something other than a ServiceTag identity. -->
    <string name="tag_eyebrow_not_ours">Not a ServiceTag tag</string>
    <!-- Sentence of a tag that holds something other than a ServiceTag identity; an offer, never an error. -->
    <string name="tag_holds_something_else">This tag holds something else.</string>
    <!-- Caption of a tag's placement (#49), on the tag sheet and as the write screen's field label. -->
    <string name="tag_placement">Tag placement</string>
    <!-- Bind-to picker heading (written in capitals). -->
    <string name="tag_picker_title">BIND THIS TAG TO</string>
    <!-- Bind-to picker row: create a new asset first. -->
    <string name="tag_picker_new_asset">New asset…</string>
    <!-- Bind-to picker row detail under "New asset…". -->
    <string name="tag_picker_new_asset_detail">Create it, then scan this tag again</string>
    <!-- Bind-to picker quiet line when there is no asset to bind to. -->
    <string name="tag_picker_empty">Nothing to bind to yet</string>
    <!-- Bind-to picker row detail for an asset with no category. -->
    <string name="tag_picker_asset">Asset</string>
    <!-- Quiet line on the tag sheet when binding failed. %1$s: the technical reason, shown as is. -->
    <string name="tag_bind_failed">Couldn\'t bind this tag: %1$s</string>

    <!--
      Why a tag is not ours: the quiet line under "This tag holds something else." It starts lower-case because it
      reads as a reason, not a sentence.
    -->
    <!-- A tag with no records on it. -->
    <string name="tag_reason_empty">empty tag</string>
    <!-- %1$s: the record's technical description (e.g. tnf=1 type=U), shown as is. -->
    <string name="tag_reason_foreign">not a ServiceTag tag: %1$s</string>
    <!-- %1$s: the technical reason the record could not be read (e.g. payload is 3 bytes, expected 18), shown as is. -->
    <string name="tag_reason_unreadable">unreadable ServiceTag record: %1$s</string>
    <!-- Any other content that is not a ServiceTag identity. -->
    <string name="tag_reason_not_ours">not a ServiceTag tag</string>
    <!-- %1$d: the tag's payload format version, newer than this app reads. -->
    <string name="tag_reason_newer_app">written by a newer ServiceTag (payload format %1$d)</string>
    <!-- The lookup of a scanned tag failed. -->
    <string name="tag_reason_unresolved">this tag could not be resolved</string>

    <!-- ===================================================================== write a tag -->

    <!-- The write screen's title. -->
    <string name="tag_write_title">Write a tag</string>
    <!-- Accessibility: the write screen's close button. -->
    <string name="tag_write_close">Close</string>
    <!-- Caption over what the tag will identify (written in capitals). -->
    <string name="tag_write_target">TARGET</string>
    <!-- What a spare tag will identify: nothing until it is bound on its first scan. -->
    <string name="tag_target_spare">nothing yet — a spare tag, bound on its first scan</string>
    <!-- What a tag will identify when the target has no name of its own. -->
    <string name="tag_target_unnamed">this target</string>
    <!-- Eyebrow of the write status before and between taps. -->
    <string name="tag_write_eyebrow_idle">Write nfc tag</string>
    <!-- Eyebrow of the write status while the overwrite question is open. -->
    <string name="tag_write_eyebrow_confirm">Overwrite this tag?</string>
    <!-- Write status while the overwrite question is open: the owner answers, then taps the tag again (consent rule, RATIFIED 2026-09-17). -->
    <string name="tag_write_answer_here">Answer here, then hold the same tag to the phone again.</string>
    <!-- Eyebrow after a verified write; the sentence is what the tag identifies. -->
    <string name="tag_write_eyebrow_written">Tag written</string>
    <!-- The written tag's identifier line. %1$s: the short id and format (e.g. a0c19962 · v1). -->
    <string name="tag_written_locked">%1$s · locked</string>
    <!-- The written tag's identifier line. %1$s: the short id and format (e.g. a0c19962 · v1). -->
    <string name="tag_written_rewritable">%1$s · rewritable</string>
    <!-- Button: leave the write screen after a verified write. -->
    <string name="tag_write_done">Done</string>
    <!-- Eyebrow of a write that did not happen. -->
    <string name="tag_write_eyebrow_error">Not written</string>
    <!-- The proof line under a verified write. -->
    <string name="tag_write_verified">Read back byte-identical</string>
    <!-- Quiet line: the write screen is shown without an activity that can own reader mode. -->
    <string name="tag_write_needs_window">Writing needs the app\'s own window.</string>
    <!-- Lock switch title. -->
    <string name="tag_lock_switch">Lock permanently</string>
    <!-- Lock switch quiet line. -->
    <string name="tag_lock_switch_hint">A locked tag can never be rewritten.</string>
    <!-- Lock warning dialog title. -->
    <string name="tag_lock_warning_title">Lock permanently?</string>
    <!-- Lock warning dialog text. -->
    <string name="tag_lock_warning_text">A locked tag can never be rewritten or reused. Only lock tags that are installed for good.</string>
    <!-- Lock warning dialog: arm the lock. -->
    <string name="tag_lock_warning_confirm">Lock after writing</string>
    <!-- Lock warning dialog: leave the switch off. -->
    <string name="tag_lock_warning_dismiss">Don\'t lock</string>

    <!-- Write status before any tap. -->
    <string name="tag_write_hold_blank">Hold a blank or reusable tag to the back of the phone.</string>
    <!-- Write error: reading the tag threw (R4). The details go to the log, not here. -->
    <string name="tag_write_read_failed">Could not read the tag. Hold it still and try again.</string>
    <!-- Write error: the tag cannot hold NDEF, with the tag types to use instead. -->
    <string name="tag_write_no_ndef_hint">This tag does not support NDEF. Use an NTAG213/215/216 or similar.</string>
    <!-- Write error: the tag cannot hold NDEF. -->
    <string name="tag_write_no_ndef">This tag does not support NDEF.</string>
    <!-- Write error: the tag is locked. -->
    <string name="tag_write_read_only">This tag is read-only (locked). Nothing written.</string>
    <!-- Write error (invariant 7). %1$d: the tag's capacity in bytes; %2$d: the bytes the message needs. -->
    <string name="tag_write_too_small">Tag too small: it holds %1$d bytes, the message needs %2$d.</string>
    <!-- Write status after a tag was only formatted (R1). -->
    <string name="tag_write_formatted">Formatted. Lift the tag off and hold it again to write.</string>
    <!-- Write error: formatting failed (E1). -->
    <string name="tag_write_format_failed">Could not format the tag. Hold it still and try again.</string>
    <!-- Write error: formatting answered something it never should. -->
    <string name="tag_write_format_unexpected">Unexpected result while formatting. Hold the tag still and try again.</string>
    <!-- Write error: writing answered something it never should. -->
    <string name="tag_write_unexpected">Unexpected result while writing. Hold the tag still and try again.</string>
    <!-- Write error: the verifying read-back did not match. -->
    <string name="tag_write_verify_mismatch">Read-back differs from what was written. Nothing recorded — try again.</string>
    <!-- Write error: the radio was never reached (I1). %1$s: the technical reason, shown as is. -->
    <string name="tag_write_not_written">Nothing was written (%1$s). Hold the tag still and try again.</string>
    <!-- Write error: the radio was reached but the write may be incomplete (I1). %1$s: the technical reason, shown as is. -->
    <string name="tag_write_may_not_have_finished">The write may not have finished (%1$s). Lift the tag off and hold it to the phone again.</string>
    <!-- Write status after "Overwrite" (consent rule, RATIFIED 2026-09-17). -->
    <string name="tag_write_overwrite_confirmed">Overwrite confirmed. Hold the same tag to the phone again to write.</string>
    <!-- Write status after "Keep it" or a dismissed overwrite sheet. -->
    <string name="tag_write_kept">Not written. The tag was left as it was.</string>

    <!-- ===================================================================== the overwrite sheet (#70, plan §5, ratified 2026-09-26) -->

    <!-- Overwrite sheet heading (written in capitals). -->
    <string name="tag_overwrite_title">OVERWRITE THIS TAG?</string>
    <!-- Overwrite sheet explanation (consent rule, RATIFIED 2026-09-17). %1$s: what the tag will identify (an asset's name, or tag_target_spare). -->
    <string name="tag_overwrite_explanation">Replacing it will make the tag identify %1$s. The old content is lost. After you confirm, hold the same tag to the phone again to write.</string>
    <!-- Overwrite sheet button: replace what is on the tag. -->
    <string name="tag_overwrite_confirm">Overwrite</string>
    <!-- Overwrite sheet button: leave the tag as it is. -->
    <string name="tag_overwrite_keep">Keep it</string>
    <!-- P70-1: the tag identifies an asset this phone knows. %1$s: the asset's name, as the owner entered it. -->
    <string name="tag_overwrite_identifies">This tag currently identifies %1$s.</string>
    <!-- P70-2: a tag this phone knows, assigned to nothing. -->
    <string name="tag_overwrite_not_assigned">This tag is in this phone\'s records but is not assigned to anything yet.</string>
    <!-- P70-3a: a tag this phone knows, marked lost. -->
    <string name="tag_overwrite_marked_lost">This tag was marked lost and taken out of service.</string>
    <!-- P70-3b: a tag this phone knows, retired. -->
    <string name="tag_overwrite_retired">This tag was retired and taken out of service.</string>
    <!-- P70-6: the lookup failed or timed out — never "not in the records" (R70-5). -->
    <string name="tag_overwrite_could_not_check">This is a ServiceTag tag, but its record could not be checked just now.</string>
    <!-- The tag holds a ServiceTag identity in a newer format. %1$s: the format version on the tag. -->
    <string name="tag_overwrite_holds_newer">The tag already holds a ServiceTag tag written by a newer app (format %1$s).</string>
    <!-- The tag holds another product's NDEF records. %1$s: their technical description (e.g. tnf=1 type=U), shown as is. -->
    <string name="tag_overwrite_holds_foreign">The tag already holds foreign NDEF content (%1$s).</string>
    <!-- The tag holds NDEF that could not be parsed. %1$s: the technical reason, shown as is. -->
    <string name="tag_overwrite_holds_unreadable">The tag already holds unreadable NDEF content (%1$s).</string>
</resources>
