<?xml version="1.0" encoding="utf-8"?>
<!--
  The quantity-bearing health lines (1.4 spec §10.7; plan decision 29), as Android plurals (#102). Each
  `other` form is the RATIFIED text; English's `one` form differs from it only by the unit's "s" — an
  inflection of a ratified string, not a new one (master plan §17.2).

  Every form, in every language, shows its number through a placeholder and never as a literal "1". That
  is what makes it safe to let the device language's plural rules pick the form: `one` also covers 21, 31,
  101 … in Russian and 0 in French, and Japanese has only `other`, so a form that wrote "1" would misreport
  every one of those numbers. With the number always substituted, whichever form a language's rules select
  says the right number, and each language pack gives the forms its own grammar needs.
-->
<resources>
    <!-- S99's <age>, inside "Replaced <date>, <age> ago" (health_replaced). %1$d: the age in days. -->
    <plurals name="health_age_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <!-- S102: an overdue-driven subject's line. %1$s: the maintenance schedule's title as entered; %2$d: how many days overdue it is. -->
    <plurals name="health_days_overdue">
        <item quantity="one">%1$s is %2$d day overdue</item>
        <item quantity="other">%1$s is %2$d days overdue</item>
    </plurals>
    <!-- S104: an overdue-driven subject inside its grace period. %1$d: the grace period's length in days. English says "14-day" in both forms; a language whose words agree with the number gives its own forms. -->
    <plurals name="health_grace_period">
        <item quantity="one">Within the %1$d-day grace period</item>
        <item quantity="other">Within the %1$d-day grace period</item>
    </plurals>
</resources>
