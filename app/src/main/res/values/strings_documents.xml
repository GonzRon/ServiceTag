<?xml version="1.0" encoding="utf-8"?>
<!--
  #102: documents, references, attachments, share intake, contacts and links — English source. Comments carry the
  ratification ids and what each string is for.

  Vocabulary: a "document" (or "file", an "attachment") is bytes stored in the owner's attachment folder on this
  phone; a "reference" (a "link") is a pointer to something elsewhere — a web page, a note in another app. A
  "supply" is a consumable product record shared across assets; an "installed component" is a part fitted inside an
  asset. File names, link names, descriptions, host names and asset/supply/component names are the owner's own text
  (or a website's) and arrive as placeholders, unchanged.
-->
<resources>
