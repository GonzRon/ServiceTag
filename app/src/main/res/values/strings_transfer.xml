    <plurals name="backup_files_already_present">
        <item quantity="one">%1$d already present</item>
        <item quantity="other">%1$d already present</item>
    </plurals>
    <!-- A part of the files-restore report. %1$d: files the archive listed but did not carry. (English keeps the plural.) -->
    <plurals name="backup_files_missing_entries">
        <item quantity="one">%1$d listed files were not in the archive</item>
        <item quantity="other">%1$d listed files were not in the archive</item>
    </plurals>
    <!-- A part of the files-restore report. %1$d: files the archive carried but never listed. (English keeps the plural.) -->
    <plurals name="backup_files_unexpected_entries">
        <item quantity="one">%1$d files in the archive were not listed</item>
        <item quantity="other">%1$d files in the archive were not listed</item>
    </plurals>
    <!-- The files archive belongs to another backup set. %1$s: the archive's set id (8 characters); %2$s: the expected one. -->
    <string name="backup_set_mismatch">Those files belong to backup set %1$s, not %2$s</string>
    <!-- A restore failed. %1$s: the system's description of the error. -->
    <string name="backup_restore_failed">Restore failed: %1$s</string>
    <!--
      P77-68 (R77-13): the restore refused a backup that still holds one asset this phone transferred out.
      %1$s: the asset's name, as it left.
    -->
    <string name="backup_restore_transferred_out_one">Restore failed: this backup still contains %1$s, which was transferred out from this phone. Nothing was replaced.</string>
    <!--
      P77-68, several assets. %1$d: how many. English shows this only for two or more (one asset is named instead,
      backup_restore_transferred_out_one), so both English forms are the ratified plural sentence.
    -->
    <plurals name="backup_restore_transferred_out_many">
        <item quantity="one">Restore failed: this backup still contains %1$d assets that were transferred out from this phone. Nothing was replaced.</item>
        <item quantity="other">Restore failed: this backup still contains %1$d assets that were transferred out from this phone. Nothing was replaced.</item>
    </plurals>

    <!-- The folder refused a new file; shown after "Export failed: ". %1$s: the file name. -->
    <string name="backup_cannot_create">cannot create %1$s in the chosen folder</string>
    <!-- A file could not be opened for writing; shown after "Export failed: ". %1$s: the file name. -->
    <string name="backup_cannot_open_for_writing">cannot open %1$s for writing</string>
    <!-- The picked file could not be opened; shown after "Restore failed: ". %1$s: the file's address. -->
    <string name="backup_cannot_open_for_reading">cannot open %1$s for reading</string>
</resources>
