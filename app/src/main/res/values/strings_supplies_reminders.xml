    <string name="reminders_health_reminders_globally_off">Reminders are turned off in ServiceTag.</string>
    <!-- DIGEST_ALARM_MISSING: the daily check that posts reminders is not scheduled. -->
    <string name="reminders_health_digest_alarm_missing">The daily reminder check is not scheduled, so today\'s maintenance may go unannounced.</string>
    <!-- BACKSTOP_WORK_MISSING: the periodic background check that catches a missed reminder is not running. -->
    <string name="reminders_health_backstop_work_missing">The background safety check is not running, so a missed reminder would not be caught.</string>
    <!-- APP_RESTRICTED: the phone's battery or background restrictions hold the app back. -->
