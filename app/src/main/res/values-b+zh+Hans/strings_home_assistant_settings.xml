<resources>
    <string name="ha_title">Home Assistant</string>
    <string name="ha_back">返回</string>
    <string name="ha_server_address">服务器地址</string>
    <string name="ha_server_address_help">请使用 https:// 加服务器名称或私有 IPv4 地址，或在家庭网络中使用 http:// 加服务器的私有 IPv4 地址。</string>
    <string name="ha_access_token">访问令牌</string>
    <string name="ha_access_token_help">一个长期访问令牌，来自专为 ServiceTag 创建且没有管理员权限的 Home Assistant 用户。ServiceTag 仅将其用于读取请求。</string>
    <string name="ha_test_connection">测试连接</string>
    <string name="ha_connection_works">Home Assistant 已响应。地址和令牌均有效。</string>
    <string name="ha_disconnect">断开连接</string>
    <string name="ha_disconnect_body">要断开与 Home Assistant 的连接吗？已关联的设备将不再跟随它，并保留当前的使用季和历史。令牌会从此手机中删除；请同时在 Home Assistant 中撤销该令牌。</string>
    <string name="ha_not_connected">未连接。请输入服务器地址和访问令牌。</string>
    <string name="ha_enter_token_again">请重新输入访问令牌：此手机上已不再保存该令牌。</string>
    <string name="ha_address_not_allowed">不允许使用该地址。请使用 https:// 加服务器名称或私有 IPv4 地址，或使用 http:// 加私有 IPv4 地址。</string>
    <string name="ha_could_not_reach">无法连接到 Home Assistant。请检查此手机是否在同一网络中。</string>
    <string name="ha_took_too_long">Home Assistant 响应时间过长。</string>
    <string name="ha_network_not_allowed">ServiceTag 未获准使用网络。请在应用设置中允许网络访问，然后关闭 ServiceTag 并重新打开。</string>
    <string name="ha_token_refused">Home Assistant 拒绝了该访问令牌。</string>
    <string name="ha_no_such_entity">Home Assistant 中没有实体%1$s。</string>
    <string name="ha_neither_on_nor_off">Home Assistant 报告%2$s的状态为\"%1$s\"，既不是 on 也不是 off，因此使用季保持不变。</string>
    <string name="ha_answer_unreadable">Home Assistant 发送了 ServiceTag 无法读取的响应。</string>
    <string name="ha_answered_with_redirect">Home Assistant 返回了重定向，而 ServiceTag 不会跟随重定向。请输入它重定向到的地址。</string>
    <string name="ha_answered_with_error">Home Assistant 返回了错误（%1$s）。</string>
    <string name="ha_token_saved">此手机上已保存一个令牌。</string>
    <string name="ha_not_on_home_wifi">此手机未连接到家庭 Wi-Fi，因此 ServiceTag 没有联系 Home Assistant。</string>
    <string name="ha_name_not_private">该服务器名称并非只解析为私有网络地址，因此 ServiceTag 没有联系它。</string>
    <string name="ha_certificate_not_verified">无法验证 Home Assistant 的证书。</string>
    <string name="ha_how_often">检查频率</string>
    <string name="ha_every_12_hours">每12小时</string>
    <string name="ha_once_a_day">每天一次</string>
    <string name="ha_once_a_week">每周一次</string>
    <string name="ha_once_a_month">每月一次</string>
    <string name="ha_where_to_check">在何处检查</string>
    <string name="ha_any_network">任何网络</string>
    <string name="ha_home_wifi_only">仅限此家庭 Wi-Fi</string>
    <string name="ha_any_network_help">仅适用于已设置为可从家庭外部访问的 https:// 地址。无论此手机连接的是哪个网络，令牌都会从该网络发送。</string>
    <string name="ha_use_this_network">使用当前所连接的网络</string>
    <string name="ha_home_wifi">家庭 Wi-Fi：%1$s</string>
    <string name="ha_precise_location_why">为了在发送访问令牌之前确认此手机连接的是家庭 Wi-Fi，ServiceTag 需要读取 Wi-Fi 网络的名称。Android 只有在授予精确位置信息权限时才允许这样做，因此请选择“精确”。ServiceTag 不会使用您的位置，但 Android 会将其列入使用过位置信息的应用中。</string>
    <string name="ha_precise_location_refused">没有精确位置信息权限，ServiceTag 无法判断这是哪个 Wi-Fi，因此“仅限此家庭 Wi-Fi”保持关闭。</string>
    <string name="ha_http_needs_home_wifi">http:// 地址需要选择“仅限此家庭 Wi-Fi”。请选择该选项，或使用 https:// 地址。</string>
    <string name="ha_turn_on_location">请开启位置信息，以便 ServiceTag 读取 Wi-Fi 网络的名称，然后重试。</string>
    <string name="ha_background_off">后台检查关闭时，如果已超过所选间隔，ServiceTag 会在您打开或返回应用时检查；您点按“立即同步”时也会检查。在使用应用期间，它仍需要精确位置信息权限。</string>
    <string name="ha_background_checks">在此家庭网络上进行后台检查</string>
    <string name="ha_off">关闭</string>
    <string name="ha_on">开启</string>
    <string name="ha_background_location_why">为了在后台检查，ServiceTag 必须在应用关闭时读取 Wi-Fi 网络的名称。Android 只有在位置信息权限设为“%1$s”时才允许这样做。ServiceTag 只读取网络名称，绝不读取您所在的位置，而且 Android 会提醒您它拥有此访问权限。</string>
    <string name="ha_background_running">当此手机连接到家庭 Wi-Fi 时，ServiceTag 也会在后台检查。</string>
    <string name="ha_background_paused">后台检查已暂停，因为 Android 不允许 ServiceTag 在后台读取 Wi-Fi 网络的名称。ServiceTag 会在您打开或返回应用时，以及您点按“立即同步”时检查。</string>
    <string name="ha_allow_again">重新允许</string>
    <string name="ha_could_not_confirm_wifi">ServiceTag 无法确认此手机已连接到家庭 Wi-Fi，因此没有联系 Home Assistant。</string>
    <string name="ha_precise_location_withdrawn">ServiceTag 已无权读取 Wi-Fi 网络的名称。请重新允许精确位置信息权限。</string>
    <string name="ha_approximate_only">ServiceTag 只有大致位置信息权限，这会隐藏 Wi-Fi 网络的名称。请在应用设置中将其改为“精确”。</string>
    <string name="ha_not_read_in_background">ServiceTag 无法在后台读取 Wi-Fi 网络的名称。它会在您打开或返回应用时再次检查。</string>
    <string name="ha_on_ethernet">使用 Ethernet 时，ServiceTag 无法判断这是哪个网络。请连接到家庭 Wi-Fi，或选择“任何网络”并使用 https:// 地址。</string>
    <string name="ha_connect_to_home_wifi">请将此手机连接到家庭 Wi-Fi，然后重试。</string>

