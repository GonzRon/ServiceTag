<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The sender's only permissions are the two contacts permissions (#72, C25): its picker seeds
         and forgets one fictional, account-less contact from this UID, so that ServiceTag - which
         holds no contacts permission - can be shown reading a pick through the one-shot grant
         another app attaches. The test grants them at run time; nothing else here uses them.
         androidx.core merges in a signature permission for its own runtime-registered receivers;
         this app registers none, so both of those lines go. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- No icon and no launcher entry: nothing here is for a person to open. -->
    <application
        android:allowBackup="false"
        android:label="ServiceTag test sender"
        tools:ignore="MissingApplicationIcon">

        <!-- exported="true" is required, not a choice: the test that drives this activity runs in
             ServiceTag's process, under ServiceTag's UID, and a non-exported activity cannot be
             started from another UID. It has no intent filter, so only an explicit intent that
             names it can reach it. It draws nothing: it copies a fixture, fires one share at
             ServiceTag's share target and finishes. -->
        <activity
            android:name=".SenderActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- #72 (C25): the contact picker ServiceTag's pick seam is aimed at in
             ContactGrantBoundaryTest. Exported for the same reason as SenderActivity - it is started
             from ServiceTag's UID - and explicit-only: no intent filter, so no ACTION_PICK ever
             resolves to it and the system picker is never displaced. It draws nothing: it seeds or
             forgets the fixture contact, answers with one result and finishes. -->
        <activity
            android:name=".PickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Serves the fixtures under an authority ServiceTag does not own. Not exported: the
             only way in is the temporary read grant a share carries. The authority deliberately
             sits outside ServiceTag's applicationId namespace: StreamSourcePolicy
             (core/.../references/StreamSourcePolicy.kt:34) refuses its own id and everything
             under it, so com.loosecannon.servicetag.* would be refused before any grant counts.
             SenderActivity.AUTHORITY carries the same string. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.loosecannon.sharetestsender.fixtures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fixtures" />
        </provider>

        <!-- androidx.core also brings the profile installer's start-up provider and its exported
             receiver. The sender is never profiled, so its exported components stay the two
             activities above. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
